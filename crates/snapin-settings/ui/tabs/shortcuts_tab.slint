import { SettingCard, Keycap, ShortcutRecorder } from "../common.slint";

export component ShortcutsTab inherits VerticalLayout {
    spacing: 16px;
    padding-right: 8px;

    in-out property <string> snip_hotkey: "Ctrl+Alt+A";
    in-out property <string> translate_hotkey: "Ctrl+Alt+D";
    in-out property <string> paste_hotkey: "F1";
    in-out property <string> toggle_hotkey: "Ctrl+F3";
    in-out property <string> switch_group_hotkey: "Shift+F3";
    in-out property <string> smart_redact_hotkey: "Ctrl+Alt+R";
    in-out property <string> qr_hotkey: "Ctrl+Alt+Q";
    in-out property <string> beautify_hotkey: "Ctrl+Alt+B";
    in-out property <string> workspace_hotkey: "Ctrl+Alt+P";
    in-out property <string> clipboard_history_hotkey: "Super+V";

    SettingCard {
        title: @tr("系统全局快捷键");
        subtitle: @tr("点击按键胶囊即可自主录制专属快捷键（支持 F1~F12、单键及多键组合，按 Backspace 或 × 清空）");

        VerticalLayout {
            spacing: 14px;

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: @tr("区域截图 (Snip)"); font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: @tr("定格屏幕并进入交互式选区裁切与标注模式"); font-size: 12px; color: #64748b; }
                }
                ShortcutRecorder {
                    shortcut <=> root.snip_hotkey;
                }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: @tr("截图翻译 (Translate)"); font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: @tr("框选完成后立即对选区执行整图 OCR 与翻译，并保留标注工具栏"); font-size: 12px; color: #64748b; }
                }
                ShortcutRecorder {
                    shortcut <=> root.translate_hotkey;
                }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: @tr("快速贴图 (Paste)"); font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: @tr("读取剪贴板图片或文字，瞬间将其转换为置顶独立窗口"); font-size: 12px; color: #64748b; }
                }
                ShortcutRecorder {
                    shortcut <=> root.paste_hotkey;
                }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: @tr("批量显隐贴图 (Toggle)"); font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: @tr("一键隐藏当前桌面所有贴图，再次按下恢复显示"); font-size: 12px; color: #64748b; }
                }
                ShortcutRecorder {
                    shortcut <=> root.toggle_hotkey;
                }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: @tr("切换贴图分组 (Switch Group)"); font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: @tr("在多个独立贴图工作区分组之间循环快速切换"); font-size: 12px; color: #64748b; }
                }
                ShortcutRecorder {
                    shortcut <=> root.switch_group_hotkey;
                }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: @tr("智能打码 (Smart Redact)"); font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: @tr("自动识别选区全部文字并进入马赛克或模糊遮挡预览"); font-size: 12px; color: #64748b; }
                }
                ShortcutRecorder { shortcut <=> root.smart_redact_hotkey; }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: @tr("二维码识别 (QR)"); font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: @tr("框选后自动检测二维码并复制内容或打开安全网页链接"); font-size: 12px; color: #64748b; }
                }
                ShortcutRecorder { shortcut <=> root.qr_hotkey; }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: @tr("美化导出 (Beautify)"); font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: @tr("为截图添加背景、圆角、阴影和水印后导出"); font-size: 12px; color: #64748b; }
                }
                ShortcutRecorder { shortcut <=> root.beautify_hotkey; }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: @tr("贴图工作区 (Workspace)"); font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: @tr("打开缩略图墙并集中管理工作区内的全部贴图"); font-size: 12px; color: #64748b; }
                }
                ShortcutRecorder { shortcut <=> root.workspace_hotkey; }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: @tr("剪贴板历史 (Clipboard)"); font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: @tr("打开最近十条文本、图像与颜色记录；再次触发快捷键或按 Esc 关闭"); font-size: 12px; color: #64748b; }
                }
                ShortcutRecorder { shortcut <=> root.clipboard_history_hotkey; }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            HorizontalLayout {
                Text {
                    text: @tr("提示：快捷键录制修改后，点击界面下方“保存并应用”即可自动同步生效至系统。");
                    font-size: 12px;
                    color: #94a3b8;
                    vertical-alignment: center;
                }
            }
        }
    }

    SettingCard {
        title: @tr("贴图窗口专属快捷操作速查");
        subtitle: @tr("光标移入置顶贴图窗口即可敲击以下单键极速操作");

        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                Text { text: @tr("复制当前图像到剪贴板"); font-size: 13px; color: #334155; vertical-alignment: center; }
                Keycap { text: "C"; }
            }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                Text { text: @tr("保存贴图为磁盘文件"); font-size: 13px; color: #334155; vertical-alignment: center; }
                Keycap { text: "S"; }
            }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                Text { text: @tr("顺时针旋转 90° / 逆时针旋转 90°"); font-size: 13px; color: #334155; vertical-alignment: center; }
                HorizontalLayout {
                    spacing: 6px;
                    Keycap { text: "3"; }
                    Keycap { text: "4"; }
                }
            }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                Text { text: @tr("水平翻转 / 垂直翻转图像"); font-size: 13px; color: #334155; vertical-alignment: center; }
                HorizontalLayout {
                    spacing: 6px;
                    Keycap { text: "H"; }
                    Keycap { text: "V"; }
                }
            }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                Text { text: @tr("按设置的缩放锚点无级缩放贴图"); font-size: 13px; color: #334155; vertical-alignment: center; }
                Keycap { text: @tr("鼠标滚轮"); }
            }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                Text { text: @tr("调节不透明度 (微调减小 / 增大)"); font-size: 13px; color: #334155; vertical-alignment: center; }
                HorizontalLayout {
                    spacing: 6px;
                    Keycap { text: "1"; }
                    Keycap { text: "2"; }
                }
            }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                Text { text: @tr("关闭当前贴图"); font-size: 13px; color: #334155; vertical-alignment: center; }
                Keycap { text: "Esc"; }
            }

            Text {
                text: @tr("提示：双击左键的行为与滚轮缩放锚点由“贴图窗口”设置页决定。");
                font-size: 12px;
                color: #94a3b8;
                wrap: word-wrap;
            }
        }
    }
}
