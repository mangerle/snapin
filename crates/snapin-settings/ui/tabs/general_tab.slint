import { ComboBox } from "std-widgets.slint";
import { SettingCard, AppSwitch, SecondaryButton } from "../common.slint";

export component GeneralTab inherits VerticalLayout {
    spacing: 16px;
    padding-right: 8px;

    in-out property <bool> autostart: true;
    in-out property <int> language_index: 0;
    in-out property <bool> notify_on_startup: false;
    in-out property <bool> auto_check_update: true;
    in-out property <int> log_level_index: 2;   // 0: Trace, 1: Debug, 2: Info, 3: Warn, 4: Error

    in property <string> extension_status_text: @tr("GNOME Shell 窗口特权扩展已部署就绪");
    callback open_config_folder();

    SettingCard {
        title: @tr("系统自启与通知");
        subtitle: @tr("配置 Snapin 随系统登录启动与后台服务状态反馈");

        VerticalLayout {
            spacing: 14px;

            AppSwitch {
                title: @tr("登录系统时自动启动后台守护服务");
                subtitle: @tr("开机静默运行，无需手动打开终端，随时响应 F1 与 F3 全局热键");
                checked <=> root.autostart;
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            VerticalLayout {
                spacing: 6px;
                Text { text: @tr("界面语言:"); font-size: 13px; font-weight: 600; color: #334155; }
                ComboBox {
                    model: [@tr("简体中文"), "English"];
                    current-index <=> root.language_index;
                    width: 200px;
                }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            AppSwitch {
                title: @tr("守护服务就绪时发送桌面通知");
                subtitle: @tr("后台服务启动成功后在系统通知中心提示热键绑定信息");
                checked <=> root.notify_on_startup;
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            AppSwitch {
                title: @tr("自动检查新版本（模式 B 轻量提醒）");
                subtitle: @tr("后台静默检查并在发现新版本时发送气泡通知，不消耗流量下载安装包");
                checked <=> root.auto_check_update;
            }
        }
    }


    SettingCard {
        title: @tr("日志调试");
        subtitle: @tr("配置底层诊断日志记录级别");

        VerticalLayout {
            spacing: 6px;
            Text {
                text: @tr("系统日志输出级别:");
                font-size: 13px;
                font-weight: 600;
                color: #334155;
            }
            ComboBox {
                model: [@tr("追踪 (Trace)"), @tr("调试 (Debug)"), @tr("标准 (Info - 推荐)"), @tr("告警 (Warn)"), @tr("错误 (Error)")];
                current-index <=> root.log_level_index;
                width: 200px;
            }
        }
    }

    SettingCard {
        title: @tr("GNOME 原生特权扩展通道");
        subtitle: @tr("为贴图授予强制置顶与精确落位特权，并提供 0 快门白闪的原生截屏");

        VerticalLayout {
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: #10b981;
                }
                Text {
                    text: root.extension_status_text;
                    font-size: 13px;
                    font-weight: 600;
                    color: #0f172a;
                    vertical-alignment: center;
                }
            }

            Text {
                text: @tr("注: GNOME Wayland 采用 ES 模块隔离架构，若新安装未生效，注销并重新登录桌面一次即可永久常驻加载。");
                font-size: 12px;
                color: #64748b;
                wrap: word-wrap;
            }
        }
    }
}
