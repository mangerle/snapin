import { ComboBox } from "std-widgets.slint";
import { SettingCard, AppSwitch, AppSlider } from "../common.slint";

export component SnipTab inherits VerticalLayout {
    spacing: 16px;
    padding-right: 8px;

    in-out property <bool> remember_last_selection: true;
    in-out property <bool> remember_toolbar_settings: false;

    in-out property <int> default_color_index: 0;  // 0: 赤红, 1: 湛蓝, 2: 翠绿, 3: 明黄, 4: 纯白, 5: 墨黑
    in-out property <float> default_stroke_width: 3; // 1 ~ 20 px
    in-out property <float> snip_font_size: 18;    // 12 ~ 48 px

    SettingCard {
        title: @tr("选区记忆");
        subtitle: @tr("控制再次截图时是否恢复上一次的选区范围");

        AppSwitch {
            title: @tr("记忆并恢复上次截图选区");
            subtitle: @tr("仅在自定义截屏时恢复上次选区；常规截图始终从空白选区开始");
            checked <=> root.remember_last_selection;
        }
    }

    SettingCard {
        title: @tr("工具栏设置记忆");
        subtitle: @tr("控制本次截图调整的标注工具设置是否沿用到下一次截图");

        AppSwitch {
            title: @tr("沿用上次标注工具设置");
            subtitle: @tr("关闭时，每次新截图恢复默认标注设置；默认关闭");
            checked <=> root.remember_toolbar_settings;
        }
    }

    SettingCard {
        title: @tr("默认标注样式");
        subtitle: @tr("配置标注的默认笔触颜色、线宽与文字字号；标注工具需在截图工具栏中自行选择");

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 28px;

                VerticalLayout {
                    spacing: 6px;
                    Text { text: @tr("默认标注笔触颜色:"); font-size: 13px; font-weight: 600; color: #334155; }
                    ComboBox {
                        model: [@tr("醒目赤红 (#EF4444)"), @tr("天海晴蓝 (#00AEFF)"), @tr("清新翠绿 (#10B981)"), @tr("明艳亮黄 (#F59E0B)"), @tr("纯洁雪白 (#FFFFFF)"), @tr("深邃墨黑 (#000000)"), @tr("保留当前自定义颜色")];
                        current-index <=> root.default_color_index;
                        width: 220px;
                    }
                }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            HorizontalLayout {
                spacing: 28px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    AppSlider {
                        title: @tr("矢量笔触描边粗细");
                        unit: " px";
                        minimum: 1;
                        maximum: 16;
                        value <=> root.default_stroke_width;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    AppSlider {
                        title: @tr("文字标注默认字号");
                        unit: " pt";
                        minimum: 12;
                        maximum: 36;
                        value <=> root.snip_font_size;
                    }
                }
            }
        }
    }
}
