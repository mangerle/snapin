import { ScrollView } from "std-widgets.slint";
import { NavItem, PrimaryButton, SecondaryButton } from "common.slint";
import { GeneralTab } from "tabs/general_tab.slint";
import { InterfaceTab } from "tabs/interface_tab.slint";
import { SnipTab } from "tabs/snip_tab.slint";
import { PasterTab } from "tabs/paster_tab.slint";
import { OutputTab } from "tabs/output_tab.slint";
import { ShortcutsTab } from "tabs/shortcuts_tab.slint";
import { OcrTab } from "tabs/ocr_tab.slint";
import { AboutTab } from "tabs/about_tab.slint";

export { ShortcutHelper } from "common.slint";

export component SettingsWindow inherits Window {
    title: "Snapin Settings";
    icon: @image-url("../../../assets/icons/snapin.svg");
    min-width: 860px;
    min-height: 560px;
    preferred-width: 900px;
    preferred-height: 620px;
    background: #f8fafc;

    // 导航项索引 (0: 常规, 1: 界面外观, 2: 截图流程, 3: 贴图窗口, 4: 输出保存, 5: 识别与翻译, 6: 快捷键, 7: 关于)
    in-out property <int> active_tab: 0;

    // 应用程序版本（由 Rust 在启动时通过 env!("CARGO_PKG_VERSION") 动态注入，无需在此硬编码）
    in-out property <string> app_version: "";

    // 底部状态提示信息
    in-out property <string> status_message: "";

    // 1. 常规设置
    in-out property <bool> autostart: true;
    in-out property <int> language_index: 0;
    in-out property <bool> notify_on_startup: false;
    in-out property <bool> auto_check_update: true;
    in-out property <int> log_level_index: 2;
    in-out property <string> extension_status_text: @tr("GNOME Shell 窗口特权扩展已就绪");

    // 8. 关于与自更新
    in-out property <int> update_status: 0;
    in-out property <string> update_version: "";
    in-out property <string> update_notes: "";
    in-out property <string> update_status_text: "";
    in-out property <float> download_progress: 0.0;
    in-out property <string> download_speed_text: "";


    // 2. 界面外观
    in-out property <int> accent_color_index: 0;
    in-out property <bool> enable_magnifier: true;
    in-out property <int> magnifier_scale_index: 1;
    in-out property <int> color_format_index: 0;
    in-out property <bool> show_grid_lines: true;
    in-out property <float> toolbar_scale_percent: 100;
    in-out property <bool> capture_mouse_cursor: false;

    // 3. 截图流程
    in-out property <bool> remember_last_selection: true;
    in-out property <bool> remember_toolbar_settings: false;
    in-out property <int> default_color_index: 0;
    in-out property <float> default_stroke_width: 3;
    in-out property <float> snip_font_size: 18;

    // 4. 贴图窗口
    in-out property <float> initial_opacity_percent: 100;
    in-out property <int> zoom_anchor_index: 0;
    in-out property <int> double_click_action_index: 0;

    // 5. 输出保存
    in-out property <string> quick_save_dir: "~/Pictures/Screenshots";
    in-out property <string> file_name_template: "Snapin_{YYYY}{MM}{DD}_{HH}{mm}{ss}";
    in-out property <int> format_index: 0;
    in-out property <float> jpeg_quality: 90;
    in-out property <bool> notify_on_copy: false;
    in-out property <bool> notify_on_save: true;
    in-out property <bool> prompt_save_path: false;
    in-out property <bool> beautify_enabled: false;
    in-out property <int> beautify_social_size_index: 0;
    in-out property <int> beautify_background_index: 0;
    in-out property <float> beautify_corner_radius: 20;
    in-out property <bool> beautify_shadow: true;
    in-out property <string> beautify_watermark: "Snapin";

    // 6. 文字识别与翻译
    in-out property <string> ocr_model_dir: "";
    in-out property <int> translate_provider_index: 0;
    in-out property <int> target_language_index: 0;
    in-out property <int> cover_mode_index: 0;
    in-out property <string> baidu_app_id: "";
    in-out property <string> baidu_secret_key: "";
    in-out property <string> youdao_app_key: "";
    in-out property <string> youdao_app_secret: "";
    in-out property <string> aliyun_access_key_id: "";
    in-out property <string> aliyun_access_key_secret: "";

    // 7. 快捷键
    in-out property <string> snip_hotkey: "Ctrl+Alt+A";
    in-out property <string> translate_hotkey: "Ctrl+Alt+D";
    in-out property <string> paste_hotkey: "F1";
    in-out property <string> toggle_hotkey: "Ctrl+F3";
    in-out property <string> switch_group_hotkey: "Shift+F3";
    in-out property <string> smart_redact_hotkey: "Ctrl+Alt+R";
    in-out property <string> qr_hotkey: "Ctrl+Alt+Q";
    in-out property <string> beautify_hotkey: "Ctrl+Alt+B";
    in-out property <string> workspace_hotkey: "Ctrl+Alt+P";
    in-out property <string> clipboard_history_hotkey: "Super+V";

    // 回调事件
    callback save_and_apply();
    callback import_config();
    callback export_config();
    callback restore_defaults();
    callback open_config_folder();
    callback check_for_updates();
    callback start_download_update();
    callback restart_and_install();


    HorizontalLayout {
        // ---------------- 左侧导航栏 ----------------
        VerticalLayout {
            width: 220px;
            padding: 16px;
            spacing: 8px;

            // 软件标识与标题
            HorizontalLayout {
                spacing: 10px;
                padding_bottom: 8px;
                alignment: start;

                Image {
                    source: @image-url("../../../assets/icons/snapin.svg");
                    width: 34px;
                    height: 34px;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "Snapin";
                        font-size: 16px;
                        font-weight: 800;
                        color: #0f172a;
                    }
                    Text {
                        text: @tr("截图与贴图设置中心");
                        font-size: 11px;
                        color: #64748b;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #e2e8f0;
            }

            // 侧边栏 7 项导航菜单
            NavItem {
                icon: @image-url("../assets/icons/nav_general.svg");
                title: @tr("常规设置");
                active: root.active_tab == 0;
                clicked => { root.active_tab = 0; }
            }
            NavItem {
                icon: @image-url("../assets/icons/nav_theme.svg");
                title: @tr("界面外观");
                active: root.active_tab == 1;
                clicked => { root.active_tab = 1; }
            }
            NavItem {
                icon: @image-url("../assets/icons/nav_snip.svg");
                title: @tr("截图流程");
                active: root.active_tab == 2;
                clicked => { root.active_tab = 2; }
            }
            NavItem {
                icon: @image-url("../assets/icons/nav_paster.svg");
                title: @tr("贴图窗口");
                active: root.active_tab == 3;
                clicked => { root.active_tab = 3; }
            }
            NavItem {
                icon: @image-url("../assets/icons/nav_output.svg");
                title: @tr("存储与输出");
                active: root.active_tab == 4;
                clicked => { root.active_tab = 4; }
            }
            NavItem {
                icon: @image-url("../assets/icons/nav_ocr.svg");
                title: @tr("识别与翻译");
                active: root.active_tab == 5;
                clicked => { root.active_tab = 5; }
            }
            NavItem {
                icon: @image-url("../assets/icons/nav_shortcuts.svg");
                title: @tr("快捷键与操作");
                active: root.active_tab == 6;
                clicked => { root.active_tab = 6; }
            }
            NavItem {
                icon: @image-url("../assets/icons/nav_about.svg");
                title: @tr("关于");
                active: root.active_tab == 7;
                clicked => { root.active_tab = 7; }
            }

            Rectangle { } // 弹性占位
        }

        // 分割线
        Rectangle {
            width: 1px;
            background: #e2e8f0;
        }

        // ---------------- 右侧内容面板 ----------------
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 24px;
            spacing: 16px;

            // 页面标题与简介栏
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: root.active_tab == 0 ? @tr("常规设置") :
                          root.active_tab == 1 ? @tr("界面与外观") :
                          root.active_tab == 2 ? @tr("截图流程") :
                          root.active_tab == 3 ? @tr("贴图窗口") :
                          root.active_tab == 4 ? @tr("存储与输出") :
                          root.active_tab == 5 ? @tr("文字识别与截图翻译") :
                          root.active_tab == 6 ? @tr("全局快捷键与贴图操作") : @tr("关于 Snapin");
                    font-size: 20px;
                    font-weight: 700;
                    color: #0f172a;
                }
                Text {
                    text: root.active_tab == 0 ? @tr("配置开机自动启动、通知中心状态反馈与 GNOME 原生扩展通道状态") :
                          root.active_tab == 1 ? @tr("定制选区高亮强调色、鼠标跟随像素放大镜与浮动工具条缩放比") :
                          root.active_tab == 2 ? @tr("配置选区记忆、默认标注颜色、笔触粗细与文字字号") :
                          root.active_tab == 3 ? @tr("配置新贴图初始不透明度、滚轮缩放锚点以及双击响应行为") :
                          root.active_tab == 4 ? @tr("配置截图另存路径、自动时间戳命名规则、图片编码格式、美化导出与通知偏好") :
                          root.active_tab == 5 ? @tr("配置轻量离线 PP-OCRv6 引擎路径、五大多语言翻译服务商凭证与截图原位智能背景擦除策略") :
                          root.active_tab == 6 ? @tr("自定义全局截图与贴图唤起热键，查看贴图窗口单键旋转、翻转、缩放快捷操作指南") : @tr("查看 Snapin 架构设计、纯 Rust 软件光栅化特性与自由开源许可声明");
                    font-size: 12px;
                    color: #64748b;
                }
            }

            Rectangle {
                height: 1px;
                background: #e2e8f0;
            }

            // 右侧核心滚动内容区
            ScrollView {
                VerticalLayout {
                    alignment: start;
                    spacing: 0px;

                    if root.active_tab == 0: GeneralTab {
                        autostart <=> root.autostart;
                        language_index <=> root.language_index;
                        notify_on_startup <=> root.notify_on_startup;
                        auto_check_update <=> root.auto_check_update;
                        log_level_index <=> root.log_level_index;
                        extension_status_text: root.extension_status_text;
                        open_config_folder => { root.open_config_folder(); }
                    }

                    if root.active_tab == 1: InterfaceTab {
                        accent_color_index <=> root.accent_color_index;
                        enable_magnifier <=> root.enable_magnifier;
                        magnifier_scale_index <=> root.magnifier_scale_index;
                        color_format_index <=> root.color_format_index;
                        show_grid_lines <=> root.show_grid_lines;
                        toolbar_scale_percent <=> root.toolbar_scale_percent;
                        capture_mouse_cursor <=> root.capture_mouse_cursor;
                    }

                    if root.active_tab == 2: SnipTab {
                        remember_last_selection <=> root.remember_last_selection;
                        remember_toolbar_settings <=> root.remember_toolbar_settings;
                        default_color_index <=> root.default_color_index;
                        default_stroke_width <=> root.default_stroke_width;
                        snip_font_size <=> root.snip_font_size;
                    }

                    if root.active_tab == 3: PasterTab {
                        initial_opacity_percent <=> root.initial_opacity_percent;
                        zoom_anchor_index <=> root.zoom_anchor_index;
                        double_click_action_index <=> root.double_click_action_index;
                    }

                    if root.active_tab == 4: OutputTab {
                        quick_save_dir <=> root.quick_save_dir;
                        file_name_template <=> root.file_name_template;
                        format_index <=> root.format_index;
                        jpeg_quality <=> root.jpeg_quality;
                        notify_on_copy <=> root.notify_on_copy;
                        notify_on_save <=> root.notify_on_save;
                        prompt_save_path <=> root.prompt_save_path;
                        beautify_enabled <=> root.beautify_enabled;
                        beautify_social_size_index <=> root.beautify_social_size_index;
                        beautify_background_index <=> root.beautify_background_index;
                        beautify_corner_radius <=> root.beautify_corner_radius;
                        beautify_shadow <=> root.beautify_shadow;
                        beautify_watermark <=> root.beautify_watermark;
                    }

                    if root.active_tab == 5: OcrTab {
                        ocr_model_dir <=> root.ocr_model_dir;
                        translate_provider_index <=> root.translate_provider_index;
                        target_language_index <=> root.target_language_index;
                        cover_mode_index <=> root.cover_mode_index;
                        baidu_app_id <=> root.baidu_app_id;
                        baidu_secret_key <=> root.baidu_secret_key;
                        youdao_app_key <=> root.youdao_app_key;
                        youdao_app_secret <=> root.youdao_app_secret;
                        aliyun_access_key_id <=> root.aliyun_access_key_id;
                        aliyun_access_key_secret <=> root.aliyun_access_key_secret;
                    }

                    if root.active_tab == 6: ShortcutsTab {
                        snip_hotkey <=> root.snip_hotkey;
                        translate_hotkey <=> root.translate_hotkey;
                        paste_hotkey <=> root.paste_hotkey;
                        toggle_hotkey <=> root.toggle_hotkey;
                        switch_group_hotkey <=> root.switch_group_hotkey;
                        smart_redact_hotkey <=> root.smart_redact_hotkey;
                        qr_hotkey <=> root.qr_hotkey;
                        beautify_hotkey <=> root.beautify_hotkey;
                        workspace_hotkey <=> root.workspace_hotkey;
                        clipboard_history_hotkey <=> root.clipboard_history_hotkey;
                    }

                    if root.active_tab == 7: AboutTab {
                        app_version: root.app_version;
                        update_status: root.update_status;
                        update_version: root.update_version;
                        update_notes: root.update_notes;
                        update_status_text: root.update_status_text;
                        download_progress: root.download_progress;
                        download_speed_text: root.download_speed_text;
                        check_for_updates => { root.check_for_updates(); }
                        start_download_update => { root.start_download_update(); }
                        restart_and_install => { root.restart_and_install(); }
                    }

                }
            }

            Rectangle {
                height: 1px;
                background: #e2e8f0;
            }

            // 底部操作栏
            HorizontalLayout {
                spacing: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    SecondaryButton {
                        text: @tr("打开配置目录");
                        clicked => { root.open_config_folder(); }
                    }
                    SecondaryButton {
                        text: @tr("恢复默认设置");
                        clicked => { root.restore_defaults(); }
                    }
                    SecondaryButton {
                        text: @tr("导入配置");
                        clicked => { root.import_config(); }
                    }
                    SecondaryButton {
                        text: @tr("导出配置");
                        clicked => { root.export_config(); }
                    }
                    if root.status_message != "": Text {
                        text: root.status_message;
                        font-size: 12px;
                        color: #10b981;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                PrimaryButton {
                    text: @tr("保存并应用");
                    clicked => { root.save_and_apply(); }
                }
            }
        }
    }
}

export component ClipboardPanel inherits Window {
    title: "Snapin Clipboard";
    icon: @image-url("../../../assets/icons/snapin.svg");
    preferred-width: 520px;
    preferred-height: 620px;
    background: #f8fafc;

    in property <[string]> titles: [];
    in property <[string]> previews: [];
    in property <string> status_message: "";
    callback activate(int);
    callback clear_history();
    callback close_panel();

    init => { panel_focus.focus(); }

    panel_focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close_panel();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 18px;
            spacing: 12px;

            HorizontalLayout {
                Text {
                    text: @tr("剪贴板历史");
                    font-size: 20px;
                    font-weight: 700;
                    color: #0f172a;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                SecondaryButton {
                    text: @tr("清空");
                    clicked => { root.clear_history(); }
                }
                SecondaryButton {
                    text: @tr("关闭");
                    clicked => { root.close_panel(); }
                }
            }

            Text {
                text: @tr("最多保留 10 条，自动删除超过 1 天的记录。点击条目立即复制并创建贴图；再次触发快捷键或按 Esc 可关闭。");
                font-size: 12px;
                color: #64748b;
                wrap: word-wrap;
            }

            ScrollView {
                VerticalLayout {
                    spacing: 8px;
                    for row[index] in root.titles : Rectangle {
                        height: 72px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #e2e8f0;
                        background: touch.has-hover ? #eff6ff : #ffffff;

                        touch := TouchArea {
                            clicked => { root.activate(index); }
                        }

                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            Text {
                                text: row;
                                font-size: 14px;
                                font-weight: 600;
                                color: #0f172a;
                            }
                            Text {
                                text: root.previews[index];
                                font-size: 12px;
                                color: #64748b;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            if root.status_message != "" : Text {
                text: root.status_message;
                font-size: 12px;
                color: #2563eb;
            }
        }
    }
}
